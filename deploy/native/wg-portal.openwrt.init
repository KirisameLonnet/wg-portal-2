#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/wg-portal-2
    procd_set_param env WG_PORTAL_CONFIG=/etc/wg-portal/config.json
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/wg-portal/config.json
    procd_close_instance
}
